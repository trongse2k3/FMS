<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Khi bấm -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0057D9" /> <!-- Màu xanh đậm khi bấm -->
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Bình thường -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#32DC38" /> <!-- Màu xanh dương thường -->
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#0057D9" />
        </shape>
    </item>
</selector>
