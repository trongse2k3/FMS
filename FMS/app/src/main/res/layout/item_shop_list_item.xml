<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp">

    <androidx.constraintlayout.widget.ConstraintLayout 
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/icon_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            
            <ImageView
                android:id="@+id/img_item_icon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="4dp"
                android:background="@drawable/rounded_item_background"
                android:contentDescription="icon" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tên vật phẩm"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/icon_card"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_buy_item"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tv_item_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Mô tả vật phẩm"
            android:textSize="13sp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/icon_card"
            app:layout_constraintTop_toBottomOf="@id/tv_item_name"
            app:layout_constraintEnd_toStartOf="@id/btn_buy_item"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tv_item_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100$"
            android:textColor="#388E3C"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="@drawable/rounded_green_button"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toEndOf="@id/icon_card"
            app:layout_constraintTop_toBottomOf="@id/tv_item_desc"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tv_item_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sở hữu: 0"
            android:textColor="#1976D2"
            android:textSize="13sp"
            android:layout_marginStart="12dp"
            app:layout_constraintEnd_toStartOf="@id/btn_buy_item"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_item_desc"
            app:layout_constraintStart_toEndOf="@id/tv_item_price"
            android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/btn_buy_item"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:text="Mua"
            android:textSize="14sp"
            android:backgroundTint="#1976D2"
            android:textColor="#fff"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView> 