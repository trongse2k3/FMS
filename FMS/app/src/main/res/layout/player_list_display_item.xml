<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:contentPadding="12dp"
    android:backgroundTint="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/player_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/t_cauthu_1"
            android:scaleType="centerCrop"
            android:contentDescription="Player Image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/player_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Player Name"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/player_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/player_overall"
            app:layout_constraintHorizontal_bias="0" />

        <TextView
            android:id="@+id/player_pos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POS"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/player_image"
            app:layout_constraintTop_toBottomOf="@id/player_name" />

        <TextView
            android:id="@+id/player_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$50,000"
            android:textColor="#FF5722"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/player_pos"
            app:layout_constraintTop_toBottomOf="@id/player_name"
            app:layout_constraintBottom_toBottomOf="parent" />
            
        <TextView
            android:id="@+id/tv_player_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="12sp"
            android:textStyle="bold|italic"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/player_image"
            app:layout_constraintTop_toBottomOf="@id/player_pos"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="Injured: 3 matches"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/player_overall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OVR: 99"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btn_use_item"/>

        <Button
            android:id="@+id/btn_use_item"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Use Item"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/player_overall"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>